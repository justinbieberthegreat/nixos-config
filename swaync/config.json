{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",

  "control-center-width": 340,
  "control-center-height": 620, 
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 2,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,

  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 0,
  "notification-body-image-width": 0,

  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 100,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "scripts": {
    "example-script": {
      "exec": "echo 'Do something...'",
      "urgency": "Normal"
    }
  },
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "mpris",
    "buttons-grid",
    "volume",
    "backlight",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All "
    },
    "dnd": {
      "text": "Do not disturb",
      "do-not-disturb-on-startup": false,
      "do-not-disturb": false
    },
    "label": {
      "max-lines": 1,
      "text": " "
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 19,
      "show-album-art": "playing",
      "blacklist": [
        "firefox",
        "chromium",
        "brave",
        "mpv",
        "playerctl"
      ],
      "autohide": true,
      "prefer": ["spotify"]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "",
      "device": "intel_backlight",
      "subsystem": "backlight", 
      "min": 10 
    },
    "buttons-grid": {
      "actions": [
        {
          "label": " ",
          "command": "swaync-client -t -sw; systemd-run --user /etc/profiles/per-user/gatinho/bin/nmgui"
        },
        {
          "label": "",
          "command": "swaync-client -t -sw; systemd-run --user /etc/profiles/per-user/gatinho/bin/overskride"
        },
        {
          "label": "",
          "command": "swaync-client -t -sw; systemctl poweroff"
        },
        {
           "label": "󰑓",
           "command": "swaync-client -t -sw; systemctl reboot"
        },
        {
         "label": "",
         "command": "swaync-client -t -sw; hyprlock"
        },
        {
          "label": "",
          "command": "swaync-client -t -sw; exec zen"
        },
        {
          "label": "",
          "command": "swaync-client -t -sw; exec spotify"
        },
        {
           "label": "",
           "command": "swaync-client -t -sw; exec codium"
        }
      ]
    }
  }
}

